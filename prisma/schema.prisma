generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  user
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHasd String    @map("password_hash")
  role         Role      @default(admin)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz
  accounts     Session[]

  @@map("user")
}

model Session {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id")
  accessToken  String   @map("access_token") @db.VarChar(255)
  refreshToken String   @map("refresh_token") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}


model HomeSlide {
  id        BigInt   @id @default(autoincrement())
  imageUrl  String   @map("image_url")
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([position, id])
  @@map("home_slides")
}

model Project {
  id            String         @id @default(uuid(7)) @db.Uuid
  name          String
  year          Int            @db.SmallInt
  location      String?        @db.VarChar(255)
  siteArea      Decimal?       @map("site_area_m2") @db.Decimal(10, 2)
  floorArea     Decimal?       @map("floor_area_m2") @db.Decimal(10, 2)
  client        String?        @db.VarChar(255)
  photographer  String?        @db.VarChar(255)
  videoUrl      String?        @map("video_url") @db.VarChar(2048)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  projectImages ProjectImage[]

  @@map("projects")
}

model ProjectImage {
  projectId     String @map("project_id") @db.Uuid
  imageUrl      String @map("image_url") @db.VarChar(1024)
  coverPriority Int?   @map("cover_priority") @db.SmallInt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, imageUrl])
  @@unique([projectId, coverPriority])
  @@map("project_images")
}
